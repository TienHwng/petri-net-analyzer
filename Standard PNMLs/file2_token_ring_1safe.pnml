<?xml version="1.0" ?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
    <net id="ee0e0c0b-42e7-4c10-9fe2-5012d81e848a" type="http://www.pnml.org/version-2009/grammar/ptnet">
        <name>
            <text>Token_Ring_1safe</text>
        </name>
        <page id="b739324b-398f-4088-8e1a-15c29c944278">
            <!-- PLACE IDs -->
            <place id="p_token">    <name><text>Token</text></name>     <graphics><position x="200" y="200"/></graphics><initialMarking><text>1</text></initialMarking></place>
            <place id="p_go">       <name><text>Go</text></name>        <graphics><position x="350" y="200"/></graphics></place>
            <place id="p_relay">    <name><text>Relay</text></name>     <graphics><position x="500" y="200"/></graphics></place>
            <place id="p_wait1">    <name><text>Wait1</text></name>     <graphics><position x="650" y="200"/></graphics></place>
            <place id="p_wait2">    <name><text>Wait2</text></name>     <graphics><position x="800" y="200"/></graphics></place>
            <place id="p_gorelay">  <name><text>GoRelay</text></name>   <graphics><position x="950" y="200"/></graphics></place>
            <place id="p_outr">     <name><text>OutR</text></name>      <graphics><position x="1100" y="200"/></graphics></place>
            <place id="p_incs">     <name><text>InCS</text></name>      <graphics><position x="1100" y="350"/></graphics></place>
            <place id="p_inr">      <name><text>InR</text></name>       <graphics><position x="950" y="350"/></graphics></place>
            <place id="p_preq">     <name><text>PReq</text></name>      <graphics><position x="800" y="350"/></graphics></place>
            <place id="p_cs">       <name><text>CS</text></name>        <graphics><position x="650" y="350"/></graphics></place>
            <place id="p_entercs">  <name><text>EnterCS</text></name>   <graphics><position x="500" y="350"/></graphics></place>
            <place id="p_exitcs">   <name><text>ExitCS</text></name>    <graphics><position x="350" y="350"/></graphics></place>
            <place id="p_idle">     <name><text>Idle</text></name>      <graphics><position x="200" y="350"/></graphics></place>
            <place id="p_int">      <name><text>InT</text></name>       <graphics><position x="200" y="500"/></graphics></place>
            <place id="p_csw">      <name><text>CSW</text></name>       <graphics><position x="350" y="500"/></graphics></place>
            <place id="p_goidle">   <name><text>GoIdle</text></name>    <graphics><position x="500" y="500"/></graphics></place>
            <place id="p_outt">     <name><text>OutT</text></name>      <graphics><position x="650" y="500"/></graphics></place>

            <!-- TRANSITION IDs -->
            <transition id="t_token_to_go">         <name><text>Token_to_Go</text></name>       <graphics><position x="275" y="200"/></graphics></transition>
            <transition id="t_go_to_relay">         <name><text>Go_to_Relay</text></name>       <graphics><position x="425" y="200"/></graphics></transition>
            <transition id="t_relay_to_wait1">      <name><text>Relay_to_Wait1</text></name>    <graphics><position x="575" y="200"/></graphics></transition>
            <transition id="t_wait1_to_wait2">      <name><text>Wait1_to_Wait2</text></name>    <graphics><position x="725" y="200"/></graphics></transition>
            <transition id="t_wait2_to_gorelay">    <name><text>Wait2_to_GoRelay</text></name>  <graphics><position x="875" y="200"/></graphics></transition>
            <transition id="t_gorelay_to_outr">     <name><text>GoRelay_to_OutR</text></name>   <graphics><position x="1025" y="200"/></graphics></transition>
            <transition id="t_outr_to_incs">        <name><text>OutR_to_InCS</text></name>      <graphics><position x="1100" y="275"/></graphics></transition>
            <transition id="t_incs_to_inr">         <name><text>InCS_to_InR</text></name>       <graphics><position x="1025" y="350"/></graphics></transition>
            <transition id="t_inr_to_preq">         <name><text>InR_to_PReq</text></name>       <graphics><position x="875" y="350"/></graphics></transition>
            <transition id="t_preq_to_cs">          <name><text>PReq_to_CS</text></name>        <graphics><position x="725" y="350"/></graphics></transition>
            <transition id="t_cs_to_entercs">       <name><text>CS_to_EnterCS</text></name>     <graphics><position x="575" y="350"/></graphics></transition>
            <transition id="t_entercs_to_exitcs">   <name><text>EnterCS_to_ExitCS</text></name> <graphics><position x="425" y="350"/></graphics></transition>
            <transition id="t_exitcs_to_idle">      <name><text>ExitCS_to_Idle</text></name>    <graphics><position x="275" y="350"/></graphics></transition>
            <transition id="t_idle_to_int">         <name><text>Idle_to_InT</text></name>       <graphics><position x="200" y="425"/></graphics></transition>
            <transition id="t_int_to_csw">          <name><text>InT_to_CSW</text></name>        <graphics><position x="275" y="500"/></graphics></transition>
            <transition id="t_csw_to_goidle">       <name><text>CSW_to_GoIdle</text></name>     <graphics><position x="425" y="500"/></graphics></transition>
            <transition id="t_goidle_to_outt">      <name><text>GoIdle_to_OutT</text></name>    <graphics><position x="575" y="500"/></graphics></transition>
            <transition id="t_outt_to_token">       <name><text>OutT_to_Token</text></name>     <graphics><position x="425" y="350"/></graphics></transition>

