<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
	<net id="DiningPhilosophers6" type="http://www.pnml.org/version-2009/grammar/ptnet">
		<name><text>Dining Philosophers Problem (6)</text></name>
		<page id="main">
			<!-- PHILOSOPHERS THINKING -->
			<place id="p1"><name><text>Phil1_Thinking</text></name><initialMarking><text>1</text></initialMarking></place>
			<place id="p2"><name><text>Phil2_Thinking</text></name><initialMarking><text>1</text></initialMarking></place>
			<place id="p3"><name><text>Phil3_Thinking</text></name><initialMarking><text>1</text></initialMarking></place>
			<place id="p4"><name><text>Phil4_Thinking</text></name><initialMarking><text>1</text></initialMarking></place>
			<place id="p5"><name><text>Phil5_Thinking</text></name><initialMarking><text>1</text></initialMarking></place>
			<place id="p6"><name><text>Phil6_Thinking</text></name><initialMarking><text>1</text></initialMarking></place>

			<!-- PHILOSOPHERS EATING -->
			<place id="p7"><name><text>Phil1_Eating</text></name></place>
			<place id="p8"><name><text>Phil2_Eating</text></name></place>
			<place id="p9"><name><text>Phil3_Eating</text></name></place>
			<place id="p10"><name><text>Phil4_Eating</text></name></place>
			<place id="p11"><name><text>Phil5_Eating</text></name></place>
			<place id="p12"><name><text>Phil6_Eating</text></name></place>

			<!-- FORKS AVAILABLE -->
			<place id="p13"><name><text>Fork1</text></name><initialMarking><text>1</text></initialMarking></place>
			<place id="p14"><name><text>Fork2</text></name><initialMarking><text>1</text></initialMarking></place>
			<place id="p15"><name><text>Fork3</text></name><initialMarking><text>1</text></initialMarking></place>
			<place id="p16"><name><text>Fork4</text></name><initialMarking><text>1</text></initialMarking></place>
			<place id="p17"><name><text>Fork5</text></name><initialMarking><text>1</text></initialMarking></place>
			<place id="p18"><name><text>Fork6</text></name><initialMarking><text>1</text></initialMarking></place>

			<!-- TRANSITIONS: START EATING -->
			<transition id="t1"><name><text>Phil1_Start</text></name></transition>
			<transition id="t2"><name><text>Phil2_Start</text></name></transition>
			<transition id="t3"><name><text>Phil3_Start</text></name></transition>
			<transition id="t4"><name><text>Phil4_Start</text></name></transition>
			<transition id="t5"><name><text>Phil5_Start</text></name></transition>
			<transition id="t6"><name><text>Phil6_Start</text></name></transition>

			<!-- TRANSITIONS: STOP EATING -->
			<transition id="t7"><name><text>Phil1_Stop</text></name></transition>
			<transition id="t8"><name><text>Phil2_Stop</text></name></transition>
			<transition id="t9"><name><text>Phil3_Stop</text></name></transition>
			<transition id="t10"><name><text>Phil4_Stop</text></name></transition>
			<transition id="t11"><name><text>Phil5_Stop</text></name></transition>
			<transition id="t12"><name><text>Phil6_Stop</text></name></transition>

			<!-- ARCS: START EATING -->
			<!-- Philosopher 1 picks up forks 1 and 6 -->
			<arc id="a1" source="p1" target="t1"/>
			<arc id="a2" source="p13" target="t1"/>
			<arc id="a3" source="p18" target="t1"/>
			<arc id="a4" source="t1" target="p7"/>

			<!-- Philosopher 2 picks up forks 1 and 2 -->
			<arc id="a5" source="p2" target="t2"/>
			<arc id="a6" source="p13" target="t2"/>
			<arc id="a7" source="p14" target="t2"/>
			<arc id="a8" source="t2" target="p8"/>

			<!-- Philosopher 3 picks up forks 2 and 3 -->
			<arc id="a9" source="p3" target="t3"/>
			<arc id="a10" source="p14" target="t3"/>
			<arc id="a11" source="p15" target="t3"/>
			<arc id="a12" source="t3" target="p9"/>

			<!-- Philosopher 4 picks up forks 3 and 4 -->
			<arc id="a13" source="p4" target="t4"/>
			<arc id="a14" source="p15" target="t4"/>
			<arc id="a15" source="p16" target="t4"/>
			<arc id="a16" source="t4" target="p10"/>

			<!-- Philosopher 5 picks up forks 4 and 5 -->
			<arc id="a17" source="p5" target="t5"/>
			<arc id="a18" source="p16" target="t5"/>
			<arc id="a19" source="p17" target="t5"/>
			<arc id="a20" source="t5" target="p11"/>

			<!-- Philosopher 6 picks up forks 5 and 6 -->
			<arc id="a21" source="p6" target="t6"/>
			<arc id="a22" source="p17" target="t6"/>
			<arc id="a23" source="p18" target="t6"/>
			<arc id="a24" source="t6" target="p12"/>

			<!-- ARCS: STOP EATING -->
			<arc id="a25" source="p7" target="t7"/>
			<arc id="a26" source="t7" target="p1"/>
			<arc id="a27" source="t7" target="p13"/>
			<arc id="a28" source="t7" target="p18"/>

			<arc id="a29" source="p8" target="t8"/>
			<arc id="a30" source="t8" target="p2"/>
			<arc id="a31" source="t8" target="p13"/>
			<arc id="a32" source="t8" target="p14"/>

			<arc id="a33" source="p9" target="t9"/>
			<arc id="a34" source="t9" target="p3"/>
			<arc id="a35" source="t9" target="p14"/>
			<arc id="a36" source="t9" target="p15"/>

			<arc id="a37" source="p10" target="t10"/>
			<arc id="a38" source="t10" target="p4"/>
			<arc id="a39" source="t10" target="p15"/>
			<arc id="a40" source="t10" target="p16"/>

			<arc id="a41" source="p11" target="t11"/>
			<arc id="a42" source="t11" target="p5"/>
			<arc id="a43" source="t11" target="p16"/>
			<arc id="a44" source="t11" target="p17"/>

			<arc id="a45" source="p12" target="t12"/>
			<arc id="a46" source="t12" target="p6"/>
			<arc id="a47" source="t12" target="p17"/>
			<arc id="a48" source="t12" target="p18"/>
		</page>
	</net>
</pnml>
